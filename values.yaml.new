# ==============================================================================
# TAZAMA HELM CHART - FLEXIBLE INFRASTRUCTURE VALUES
# ==============================================================================
# Supports three deployment modes:
#   1. INTERNAL (default) — Auto-scaffolded infrastructure
#   2. EXTERNAL — Connect to managed services (AWS RDS, ElastiCache, etc.)
#   3. HYBRID — Mix internal and external per-service
#
# CONSTRAINTS IMPLEMENTED:
#   C1: Infrastructure NOT deployed when external.enabled=true
#   C2: Internal and external are mutually exclusive
#   C4: Credentials never in values.yaml (secretRef pattern)
#   C5: Secrets never have working placeholder values
#   C13: Defaults preserve current behavior (backward compat)
#   C10: Chart fails if required dependencies unavailable
# ==============================================================================

global:
  tazamaVersion: "rc"
  imageRegistry: "docker.io/tazamaorg"
  storageClass: "longhorn-single"

# ==============================================================================
# INFRASTRUCTURE: POSTGRESQL DATABASE
# ==============================================================================
# Three mutually exclusive modes:
#   - enabled=true, external.enabled=false → Internal (default)
#   - enabled=false, external.enabled=true → External managed
#   - disabled=true → No database (fails if services need it)
infrastructure:
  postgres:
    # ---------------------------------------------------------------------------
    # MODE 1: INTERNAL INFRASTRUCTURE (current default) [C13]
    # ---------------------------------------------------------------------------
    enabled: true  # Default preserves backward compatibility
    disabled: false
    
    image: "postgres:18-alpine"
    storageSize: "5Gi"
    
    # Internal resource configuration
    resources:
      requests:
        cpu: "100m"
        memory: "256Mi"
      limits:
        cpu: "500m"
        memory: "512Mi"
    
    # Persistence settings
    persistence:
      enabled: true
      storageClass: ""  # Falls back to global.storageClass
      accessMode: ReadWriteOnce
      retentionPolicy: Retain  # [C7: Never delete PVC without explicit intent]
    
    # ---------------------------------------------------------------------------
    # MODE 2: EXTERNAL MANAGED SERVICE
    # ---------------------------------------------------------------------------
    external:
      enabled: false  # When true, internal StatefulSet is NOT created [C1]
      
      # Connection endpoint (REQUIRED if external.enabled=true)
      host: ""
      port: 5432
      
      # Default database name
      database: "tazama"
      
      # TLS Configuration [C14: Never bypass TLS without explicit waiver]
      ssl:
        enabled: true
        require: true        # Fail if TLS cannot be negotiated
        skipVerify: false    # SECURITY WARNING: true bypasses cert verification
      
      # Credential injection via Kubernetes Secret [C4]
      # REQUIRED when external.enabled=true [C10]
      # User must create: kubectl create secret generic <name> --from-literal=user=... --from-literal=password=...
      secretRef:
        name: ""             # REQUIRED: e.g., "rds-credentials"
        keys:
          user: "user"
          password: "password"
      
      # Connection pooling (optional)
      connectionPool:
        maxConnections: 20
        idleTimeout: 300

  # ==============================================================================
  # INFRASTRUCTURE: VALKEY (Redis-compatible Cache)
  # ==============================================================================
  valkey:
    enabled: true  # Default: internal [C13]
    disabled: false
    
    image: "valkey/valkey:7.2.5"
    
    resources:
      requests:
        cpu: "50m"
        memory: "64Mi"
      limits:
        cpu: "200m"
        memory: "256Mi"
    
    persistence:
      enabled: false
      storageSize: "1Gi"
    
    external:
      enabled: false
      
      host: ""       # e.g., "mycache.xxxx.cache.amazonaws.com"
      port: 6379
      
      ssl:
        enabled: true
        skipVerify: false
      
      secretRef:
        name: ""
        keys:
          password: "password"
      
      # Cluster mode for AWS ElastiCache Cluster
      cluster:
        enabled: false
        nodes: []

  # ==============================================================================
  # INFRASTRUCTURE: NATS (Message Broker)
  # ==============================================================================
  nats:
    enabled: true  # Default: internal [C13]
    
    image: "nats:2"
    
    # NATS JetStream Configuration (persistence)
    jetStream:
      enabled: true           # Enable JetStream for message persistence
      storageSize: "5Gi"      # PVC size for JetStream storage
      maxMemory: "512Mi"      # Max memory for JetStream stream storage (optional)
      maxStore: "2Gi"         # Max disk storage for JetStream streams (optional)
    
    resources:
      requests:
        cpu: "100m"
        memory: "256Mi"
      limits:
        cpu: "500m"
        memory: "1Gi"
    
    # External NATS configuration
    external:
      enabled: false
      
      # Single NATS endpoint
      host: ""
      port: 4222
      
      # OR cluster endpoints (use this for HA clusters)
      cluster:
        enabled: false
        urls: []
        # urls:
        #   - "nats://nats-1.example.com:4222"
        #   - "nats://nats-2.example.com:4222"
        #   - "nats://nats-3.example.com:4222"
      
      # TLS Configuration
      ssl:
        enabled: true
        skipVerify: false
      
      # Credential reference (Secret must contain: user, password)
      # OR for JWT auth: jwt, seed (nkey seed)
      secretRef:
        name: ""
        keys:
          user: "user"
          password: "password"
          # JWT auth (optional):
          jwt: "jwt"
          seed: "seed"

# ==============================================================================
# CORE SERVICES CONFIGURATION
# ==============================================================================
core:
  adminService:
    port: 3100
    replicas: 1
    resources:
      requests:
        cpu: "100m"
        memory: "128Mi"
      limits:
        cpu: "500m"
        memory: "512Mi"
  
  tms:
    port: 3000
    replicas: 1
    resources:
      requests:
        cpu: "100m"
        memory: "128Mi"
      limits:
        cpu: "500m"
        memory: "512Mi"

# ==============================================================================
# USAGE EXAMPLES
# ==============================================================================
#
# EXAMPLE 1: INTERNAL (default, current behavior)
# -----------------------------------------------
# helm install tazama ./tazama-helm-derived
# 
# Result:
#   - PostgreSQL StatefulSet deployed in-cluster
#   - Valkey Deployment deployed in-cluster
#   - NATS Deployment deployed in-cluster
#   - Services connect via: postgres:5432, valkey:6379, nats:4222
#
#
# EXAMPLE 2: EXTERNAL MANAGED SERVICES (AWS RDS + ElastiCache)
# ------------------------------------------------------------
# # Pre-requisite: Create secrets
# kubectl create secret generic rds-credentials \
#   --from-literal=user=tazama_admin \
#   --from-literal=password=<secure-password>
#
# kubectl create secret generic elasticache-credentials \
#   --from-literal=password=<redis-password>
#
# helm install tazama ./tazama-helm-derived \
#   --set infrastructure.postgres.enabled=false \
#   --set infrastructure.postgres.external.enabled=true \
#   --set infrastructure.postgres.external.host=mydb.xxxx.rds.amazonaws.com \
#   --set infrastructure.postgres.external.secretRef.name=rds-credentials \
#   --set infrastructure.valkey.enabled=false \
#   --set infrastructure.valkey.external.enabled=true \
#   --set infrastructure.valkey.external.host=mycache.xxxx.cache.amazonaws.com \
#   --set infrastructure.valkey.external.secretRef.name=elasticache-credentials
#
# Result:
#   - NO PostgreSQL StatefulSet [C1]
#   - NO Valkey Deployment [C1]
#   - NATS deployed internally
#   - Services connect to AWS RDS and ElastiCache
#
#
# EXAMPLE 3: HYBRID (External DB, Internal Cache)
# -----------------------------------------------
# helm install tazama ./tazama-helm-derived \
#   --set infrastructure.postgres.enabled=false \
#   --set infrastructure.postgres.external.enabled=true \
#   --set infrastructure.postgres.external.host=mydb.xxxx.rds.amazonaws.com \
#   --set infrastructure.postgres.external.secretRef.name=rds-credentials \
#   --set infrastructure.valkey.enabled=true
#
# Result:
#   - PostgreSQL: External (AWS RDS)
#   - Valkey: Internal (in-cluster)
#   - NATS: Internal (in-cluster)
#
# ==============================================================================


# ==============================================================================
# VALIDATION SETTINGS
# ==============================================================================
# Controls infrastructure validation behavior.
#
# validation.enabled -- Enable pre-install/pre-upgrade validation hooks
#                        (default: true)
#
# validationWarningsSuppressed -- Suppress informational warnings about
#                                  security implications while keeping errors
#                                  (default: false)
#
# ==============================================================================

validation:
  enabled: true

# Set to true if you want to suppress SECURITY WARNING messages
# Note: This does NOT suppress validation errors - only info-level warnings
validationWarningsSuppressed: false
